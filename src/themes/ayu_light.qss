QWidget {
    background-color: #fafafa;
    color: #5c6166;
    font-family: "Rubik","DejaVu Sans", "Ubuntu Sans", "Sans Serif";
    font-size: 14px;
}

QMainWindow, QStackedWidget, QScrollArea {
    background-color: #fafafa;
    border: none;
}

QWidget#pageHome {
    background-color: #fafafa;
}

QLabel#title {
    background: transparent;
    color: #45484c;
    font-size: 44px;
    font-weight: 700;
    letter-spacing: 1px;
    height: 50px;
}

QLabel#subtitle {
    color: #7a828b;
    font-size: 15px;
}

QLabel#heading {
    color: #45484c;
    font-size: 20px;
    font-weight: 600;
}

QLabel#keyLabel {
    background: transparent;
    min-width: 40px;
    color: #6d747d;
    font-size: 13px;
}

QLabel#sectionLabel {
    color: #6d747d;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
}

QLabel#about {
    background: transparent;
    font-size: 15px;
    line-height: 1.4;
}

QLabel#aboutLine {
    background: transparent;
    color: #5c6166;
    font-size: 15px;
    padding: 1px 0;
}

QLabel#versionBadge {
    background-color: #ffffff;
    color: #828a94;
    border: 1px solid #e2e5e8;
    border-radius: 10px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QLabel#status {
    color: #6d747d;
    font-size: 13px;
    padding: 2px 4px;
}

QLabel#statusOk {
    color: #7fa32b;
    font-size: 13px;
    padding: 2px 4px;
}

QLabel#statusErr {
    color: #d1565e;
    font-size: 13px;
    padding: 2px 4px;
}

QLabel#divider {
    background-color: #e6b450;
    border-radius: 1px;
}

QWidget#sidebar {
    background-color: #f5f6f7;
}

QLabel#brand {
    background: transparent;
    color: #45484c;
    font-size: 17px;
    font-weight: 700;
    padding: 0 8px;
}

QLabel#brandTag {
    background: transparent;
    color: #7a828b;
    font-size: 12px;
    padding: 0 8px;
}

QPushButton#navBtn {
    background-color: transparent;
    color: #828a94;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 4px;
    padding: 8px 14px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#navBtn:hover {
    color: #45484c;
    background-color: #e8eaec;
}

QPushButton#navBtn:checked {
    color: #b8860b;
    background-color: #e8eaec;
    border-left: 3px solid #b8860b;
    font-weight: 600;
}

QLabel#version {
    background: transparent;
    color: #a0a6ad;
    font-size: 11px;
    padding: 0 8px;
}

QLabel#footer {
    background: transparent;
    color: #a0a6ad;
    font-size: 12px;
}

QPushButton {
    background-color: #ffffff;
    color: #5c6166;
    border: 1px solid #d3d6da;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #f2f4f6;
    border-color: #b8bdc4;
}

QPushButton:pressed {
    background-color: #eceef0;
}

QPushButton:disabled {
    color: #a0a6ad;
    background-color: #f0f2f4;
    border-color: #dcdfe3;
}

QPushButton#primaryBtn {
    background-color: #e6b450;
    color: #0b0e14;
    border: 1px solid #e6b450;
    border-radius: 6px;
    font-weight: 600;
    padding: 9px 22px;
}

QPushButton#primaryBtn:hover {
    background-color: #ffb454;
    border-color: #ffb454;
}

QPushButton#primaryBtn:pressed {
    background-color: #d19c2e;
    border-color: #d19c2e;
}

QPushButton#secondaryBtn {
    background-color: transparent;
    color: #b8860b;
    border: 1px solid #c9b97e;
    border-radius: 6px;
    font-weight: 600;
    padding: 9px 22px;
}

QPushButton#secondaryBtn:hover {
    border-color: #e6b450;
    background-color: #fbf6e8;
}

QPushButton#secondaryBtn:pressed {
    background-color: #f4efdd;
}

QPushButton#ghostBtn {
    background-color: transparent;
    color: #828a94;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 9px 18px;
    font-size: 13px;
}

QPushButton#ghostBtn:hover {
    color: #45484c;
    border-color: #d3d6da;
    background-color: #eef0f2;
}

QPushButton#ghostBtn:pressed {
    background-color: #eceef0;
}

QPushButton#miniBtn {
    background-color: transparent;
    color: #828a94;
    border: 1px solid #d3d6da;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 12px;
}

QPushButton#miniBtn:hover {
    color: #b8860b;
    border-color: #b8bdc4;
    background-color: #ffffff;
}

QPushButton#miniBtn:pressed {
    background-color: #eceef0;
}

QPushButton#themeBtn {
    background-color: transparent;
    color: #828a94;
    border: 1px solid #d3d6da;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 12px;
    text-align: left;
}

QPushButton#themeBtn:hover {
    color: #b8860b;
    border-color: #b8bdc4;
    background-color: #ffffff;
}

QPushButton#themeBtn:pressed {
    background-color: #eceef0;
}

QWidget#panel {
    background-color: #ffffff;
    border: 1px solid #e2e5e8;
    border-radius: 8px;
}

QLabel#panelTitle {
    background: transparent;
    color: #b8860b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#countLabel {
    background: transparent;
    color: #7a828b;
    font-size: 11px;
    padding: 0 4px;
}

QLabel#chip {
    background-color: #ffffff;
    color: #5c6166;
    border: 1px solid #e2e5e8;
    border-radius: 14px;
    padding: 8px 20px;
    font-size: 14px;
}

QLabel#note {
    color: #7a828b;
    font-size: 13px;
}

QWidget#chipsHost {
    background: transparent;
}

QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background-color: #ffffff;
    color: #5c6166;
    border: 1px solid #d3d6da;
    border-radius: 5px;
    padding: 6px 10px;
    selection-background-color: #e6b450;
    selection-color: #0b0e14;
}

QPlainTextEdit#outputPane {
    background-color: #ffffff;
    border: 1px solid #d9d2b8;
}

QPlainTextEdit#outputPane:focus {
    border: 1px solid #e6b450;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1px solid #e6b450;
}

QLineEdit::placeholder {
    color: #8a94a6;
}

QPlainTextEdit {
    font-size: 13px;
    padding: 10px;
}

QComboBox {
    padding: 7px 12px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #5c6166;
    border: 1px solid #d3d6da;
    padding: 4px;
    selection-background-color: #e6b450;
    selection-color: #0b0e14;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #ffffff;
    border: none;
    width: 18px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #f2f4f6;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e5e8;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 4px;
    color: #b8860b;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #45484c;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c3c8cf;
    border-radius: 2.5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #a9afb7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c3c8cf;
    border-radius: 2.5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #a9afb7;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #ffffff;
    color: #45484c;
    border: 1px solid #d3d6da;
    padding: 4px 8px;
}
